# Public browser configuration. These values are visible in the built website.
# Get them from your Supabase / Lovable Cloud project settings.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT

# Optional local Lovable server build configuration (not shipped to Pages).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_PROJECT_ID=YOUR_PROJECT
# Keep LOVABLE_API_KEY only in backend secrets, never in a VITE_ variable.

# Optional separate AI project; public gateway configuration only.
# Keep the existing VITE_SUPABASE_* settings to preserve accounts/trips.
VITE_AI_FUNCTIONS_URL=https://YOUR_AI_PROJECT.supabase.co/functions/v1
# Existing legacy anon JWT from AI project (public, not service_role).
VITE_AI_GATEWAY_KEY=REPLACE_WITH_AI_PROJECT_PUBLIC_ANON_JWT
# OPENAI_API_KEY belongs ONLY in Supabase Edge Function secrets.
# Optional public Edge Function URL. Leave empty until the hotel sandbox is deployed.
# Private NUITEE_SANDBOX_API_KEY belongs only in Supabase Edge Function secrets.
VITE_HOTEL_SEARCH_URL=

# Public function URL only. GOOGLE_ROUTES_API_KEY belongs only in backend secrets.
VITE_TRANSPORT_ROUTES_URL=

# Public URL only. SERPAPI_API_KEY belongs only in Edge Function secrets.
VITE_FLIGHT_SEARCH_URL=
