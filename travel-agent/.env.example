# Travel Planner Agent — LLM credentials
#
# LLM_PROVIDER picks a preset (see agent.py -> PROVIDERS):
#      ollama     Local model via Ollama — no key, fully offline
#      gemini     Google AI Studio, free tier, no card needed
#      groq       Groq, free tier, no card needed
#      openrouter OpenRouter, free models
#      openai     OpenAI (paid)
#
# Only providers that talk to a remote service need OPENAI_API_KEY.

LLM_PROVIDER=ollama
# OPENAI_API_KEY=your-key-here

# --- Optional overrides ---------------------------------------------------
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:3b
# LLM_TEMPERATURE=0.4
